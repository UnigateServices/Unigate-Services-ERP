# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://tradivia:tradivia@localhost:5432/tradivia_finance?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# App
NODE_ENV="development"
API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Uploads (local development)
UPLOAD_DIR="./uploads"

# Company (single tenant for now)
DEFAULT_COMPANY_ID="tradivia"
