{
  "name": "tradivia-finance-v2",
  "version": "0.1.0",
  "private": true,
  "description": "TRADIVIA Finance v2 — NestJS + Next.js + PostgreSQL + Prisma",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run start:dev -w @tradivia/api",
    "dev:web": "npm run dev -w @tradivia/web",
    "build": "npm run build -w @tradivia/api && npm run build -w @tradivia/web",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:push": "prisma db push --schema packages/database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/database/prisma/schema.prisma",
    "db:seed": "npm run seed -w @tradivia/database",
    "postinstall": "npm run db:generate"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prisma": "^6.16.3"
  }
}
