  productId   String      @map("product_id")
  productName String      @map("product_name")
  sku         String      @default("")
  unit        ProductUnit
  quantity     Decimal      @db.Decimal(18, 4)
  unitPrice    Decimal      @map("unit_price") @db.Decimal(18, 4)
  discountMode DiscountMode @default(AMOUNT) @map("discount_mode")
  discountRate Decimal      @default(0) @map("discount_rate") @db.Decimal(18, 4)
  discount     Decimal      @default(0) @db.Decimal(18, 4)
  lineTotal    Decimal      @map("line_total") @db.Decimal(18, 4)
  nrvRelease   Decimal      @default(0) @map("nrv_release") @db.Decimal(18, 4)
  sortOrder   Int         @map("sort_order")

  invoice SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("sales_invoice_lines")
}

/// Point-in-time IAS 2 measurement: carrying amount is the lower of weighted-average cost and net realizable value.
model InventoryAssessment {
  id              String    @id @default(cuid())
  companyId       String    @default("tradivia") @map("company_id")
  reference       String
  transactionDate DateTime  @map("transaction_date") @db.Date
