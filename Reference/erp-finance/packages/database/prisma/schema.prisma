  updatedAt  DateTime           @updatedAt @map("updated_at")

  invoice  SalesInvoice @relation(fields: [invoiceId], references: [id])
  income   Income       @relation(fields: [incomeId], references: [id])
  employee Employee     @relation(fields: [employeeId], references: [id])

  @@index([companyId, invoiceId])
  @@index([employeeId])
  @@map("sales_invoice_payments")
}

model Supplier {
  id        String       @id @default(cuid())
  companyId String       @default("tradivia") @map("company_id")
  name      String
  phone     String       @default("")
  address   String       @default("")
  notes     String       @default("")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  invoices  PurchaseInvoice[]
  openItems OpenItem[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@map("suppliers")
}

/// Commercial purchase. Stock is received only when POSTED. Cash is a separate payment that creates an outcome.
model PurchaseInvoice {
  id              String             @id @default(cuid())
  companyId       String             @default("tradivia") @map("company_id")
  number          Int
  reference       String
  transactionDate DateTime           @map("transaction_date") @db.Date
  supplierId      String             @map("supplier_id")
  supplierName    String             @map("supplier_name")
  warehouseId     String             @map("warehouse_id")
  warehouseName   String             @map("warehouse_name")
  currency        Currency
  fxRate          Decimal?           @map("fx_rate") @db.Decimal(18, 6)
  notes           String             @default("")
  discount        Decimal            @default(0) @db.Decimal(18, 4)
  subtotal        Decimal            @default(0) @db.Decimal(18, 4)
  total           Decimal            @default(0) @db.Decimal(18, 4)
  status          SalesInvoiceStatus @default(DRAFT)
  employeeId      String             @map("employee_id")
  locationId      String?            @map("location_id")
  postedAt        DateTime?          @map("posted_at")
  voidedAt        DateTime?          @map("voided_at")
  voidReason      String             @default("") @map("void_reason")
  voidedById      String?            @map("voided_by_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  supplier  Supplier                 @relation(fields: [supplierId], references: [id])
  warehouse Warehouse                @relation(fields: [warehouseId], references: [id])
  employee  Employee                 @relation(fields: [employeeId], references: [id])
  location  Location?                @relation(fields: [locationId], references: [id])
  voidedBy  Employee?                @relation("PurchaseVoidedBy", fields: [voidedById], references: [id])
  lines     PurchaseInvoiceLine[]
  payments  PurchaseInvoicePayment[]

  @@unique([companyId, number])
  @@unique([companyId, reference])
  @@index([companyId, status, transactionDate])
  @@index([supplierId])
  @@index([warehouseId])
  @@index([employeeId])
  @@index([locationId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id          String      @id @default(cuid())
  invoiceId   String      @map("invoice_id")
  productId   String      @map("product_id")
  productName String      @map("product_name")
  sku         String      @default("")
  unit        ProductUnit
  quantity    Decimal     @db.Decimal(18, 4)
  unitPrice   Decimal     @map("unit_price") @db.Decimal(18, 4)
  discount    Decimal     @default(0) @db.Decimal(18, 4)
  lineTotal   Decimal     @map("line_total") @db.Decimal(18, 4)
  sortOrder   Int         @map("sort_order")

  invoice PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@map("purchase_invoice_lines")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum JournalStatus {
  DRAFT
  POSTED
}

enum PeriodStatus {
  OPEN
  CLOSED
}

enum BudgetStatus {
  DRAFT
  ACTIVE
}

/// Analytical dimension. A center mirrors a project, an office, or stands alone.
enum CostCenterKind {
  PROJECT
  LOCATION
  MANUAL
}

model Account {
  id        String       @id @default(cuid())
  companyId String       @default("tradivia") @map("company_id")
  code      String
  name      String
  type      AccountType
  status    RecordStatus @default(ACTIVE)
  system        Boolean      @default(false)
  /// IFRS presentation line. The reporting engine groups posted balances by this code.
  statementLine String       @default("") @map("statement_line")
  parentId      String?      @map("parent_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  parent      Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children    Account[]     @relation("AccountTree")
  lines       JournalLine[]
  budgetLines BudgetLine[]

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId, type])
  @@index([parentId])
  @@map("accounts")
}

model JournalEntry {
  id              String        @id @default(cuid())
  companyId       String        @default("tradivia") @map("company_id")
  number          Int
  transactionDate DateTime      @map("transaction_date") @db.Date
  description     String        @default("")
  status          JournalStatus @default(DRAFT)
  employeeId      String        @map("employee_id")
  locationId      String?       @map("location_id")
  reversalOfId    String?       @unique @map("reversal_of_id")
  sourceType      String?       @map("source_type")
  sourceId        String?       @map("source_id")
  sourceKey       String?       @unique @map("source_key")
  exchange        Boolean       @default(false)
  postedAt        DateTime?     @map("posted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  employee   Employee       @relation(fields: [employeeId], references: [id])
  location   Location?      @relation(fields: [locationId], references: [id])
  reversalOf JournalEntry?  @relation("JournalReversal", fields: [reversalOfId], references: [id])
  reversedBy JournalEntry?  @relation("JournalReversal")
  lines      JournalLine[]

  @@unique([companyId, number])
  @@index([companyId, status, transactionDate])
  @@index([employeeId])
  @@index([locationId])
  @@map("journal_entries")
}

model JournalLine {
  id        String   @id @default(cuid())
  entryId   String   @map("entry_id")
  accountId String   @map("account_id")
  currency  Currency
  debit     Decimal  @default(0) @db.Decimal(18, 4)
  credit    Decimal  @default(0) @db.Decimal(18, 4)
  memo      String   @default("")
  sortOrder    Int      @map("sort_order")
  /// Office dimension. Mandatory on income and expense lines (enforced by trigger journal_lines_center_guard).
  costCenterId String?  @map("cost_center_id")
  /// Project dimension. Independent from the office so both profitability views stay correct.
  projectId    String?  @map("project_id")
  fxRate       Decimal? @map("fx_rate") @db.Decimal(18, 6)

  entry      JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account    Account      @relation(fields: [accountId], references: [id])
  costCenter CostCenter?  @relation(fields: [costCenterId], references: [id])
  project    Project?     @relation(fields: [projectId], references: [id])

  @@index([entryId])
  @@index([accountId])
  @@index([costCenterId])
  @@index([projectId])
  @@map("journal_lines")
}

model CostCenter {
  id         String         @id @default(cuid())
  companyId  String         @default("tradivia") @map("company_id")
  code       String
  name       String
  kind       CostCenterKind
  status     RecordStatus   @default(ACTIVE)
  projectId  String?        @unique @map("project_id")
  locationId String?        @unique @map("location_id")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  project  Project?      @relation(fields: [projectId], references: [id])
  location Location?     @relation(fields: [locationId], references: [id])
  lines    JournalLine[]

  @@unique([companyId, code])
  @@index([companyId, status])
  @@map("cost_centers")
}

model PurchaseInvoicePayment {
  id         String             @id @default(cuid())
  companyId  String             @default("tradivia") @map("company_id")
  invoiceId  String             @map("invoice_id")
  outcomeId  String             @unique @map("outcome_id")
  amount     Decimal            @db.Decimal(18, 4)
  status     SalesPaymentStatus @default(POSTED)
  reason     String             @default("")
  employeeId String             @map("employee_id")
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  invoice  PurchaseInvoice @relation(fields: [invoiceId], references: [id])
  outcome  Outcome         @relation(fields: [outcomeId], references: [id])
  employee Employee        @relation(fields: [employeeId], references: [id])

  @@index([companyId, invoiceId])
  @@index([employeeId])
  @@map("purchase_invoice_payments")
}

model AccountingPolicy {
  id                 String   @id @default(cuid())
  companyId          String   @unique @default("tradivia") @map("company_id")
  functionalCurrency Currency @default(USD) @map("functional_currency")
  inventoryMethod    String   @default("WAC") @map("inventory_method")
  functionalLocked   Boolean  @default(false) @map("functional_locked")
  openingLocked      Boolean  @default(false) @map("opening_locked")
  inventoryLocked    Boolean  @default(false) @map("inventory_locked")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("accounting_policies")
}

/// End-of-day remeasurement of the open foreign-currency position.
model FxRevaluation {
  id             String   @id @default(cuid())
  companyId      String   @default("tradivia") @map("company_id")
  asOf           DateTime @map("as_of") @db.Date
  rate           Decimal  @db.Decimal(18, 6)
  functional     Currency
  foreignQty     Decimal  @map("foreign_qty") @db.Decimal(18, 4)
  carrying       Decimal  @db.Decimal(18, 4)
  closingValue   Decimal  @map("closing_value") @db.Decimal(18, 4)
  gain           Decimal  @db.Decimal(18, 4)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([companyId, asOf])
  @@index([companyId])
  @@map("fx_revaluations")
}

model FiscalYear {
  id        String       @id @default(cuid())
  companyId String       @default("tradivia") @map("company_id")
  year      Int
  status    PeriodStatus @default(OPEN)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  periods FiscalPeriod[]

  @@unique([companyId, year])
  @@index([companyId])
  @@map("fiscal_years")
}

model FiscalPeriod {
  id        String       @id @default(cuid())
  companyId String       @default("tradivia") @map("company_id")
  yearId    String       @map("year_id")
  year      Int
  month     Int
  startsOn  DateTime     @map("starts_on") @db.Date
  endsOn    DateTime     @map("ends_on") @db.Date
  status    PeriodStatus @default(OPEN)
  closedAt  DateTime?    @map("closed_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  yearRecord FiscalYear @relation(fields: [yearId], references: [id])

  @@unique([companyId, year, month])
  @@index([companyId, status])
  @@map("fiscal_periods")
}

model Budget {
  id        String       @id @default(cuid())
  companyId String       @default("tradivia") @map("company_id")
  name      String
  year      Int
  currency  Currency
  status    BudgetStatus @default(DRAFT)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  lines BudgetLine[]

  @@unique([companyId, year, currency, name])
  @@index([companyId, year])
  @@map("budgets")
}

model BudgetLine {
  id        String  @id @default(cuid())
  budgetId  String  @map("budget_id")
  accountId String  @map("account_id")
  month     Int
  amount    Decimal @db.Decimal(18, 4)

  budget  Budget  @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@unique([budgetId, accountId, month])
  @@index([accountId])
  @@map("budget_lines")
}

/// ISO catalog. Activation decides what can be used. The base currency lives on AccountingPolicy.
model CompanyCurrency {
  id        String   @id @default(cuid())
  companyId String   @default("tradivia") @map("company_id")
  code      String
  name      String
  active    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, code])
  @@index([companyId, active])
  @@map("company_currencies")
}

/// Rate saved for one calendar day. For the USD/SYP pair the number is Syrian pounds per one dollar.
model DailyRate {
  id        String   @id @default(cuid())
  companyId String   @default("tradivia") @map("company_id")
  code      String
  rateDate  DateTime @map("rate_date") @db.Date
  rate      Decimal  @db.Decimal(18, 6)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, code, rateDate])
  @@index([companyId, rateDate])
  @@map("daily_rates")
}

enum OpenItemParty {
  CUSTOMER
  SUPPLIER
  BORROWER
}

enum OpenItemKind {
  RECEIVABLE
  PAYABLE
  ADVANCE_IN
  ADVANCE_OUT
  /// Borrower custody: cash handed to a borrower and not yet spent. Control account 1300.
  CUSTODY
}

enum SettlementMode {
  CASH
  GOODS
}

enum OpenItemStatus {
  OPEN
  CLOSED
}

model OpenItem {
  id             String         @id @default(cuid())
  companyId      String         @default("tradivia") @map("company_id")
  party          OpenItemParty
  customerId     String?        @map("customer_id")
  supplierId     String?        @map("supplier_id")
  borrowerId     String?        @map("borrower_id")
  /// Office and employee that created the item. Used to scope borrower custody the same way operations are scoped.
  locationId     String?        @map("location_id")
  employeeId     String?        @map("employee_id")
  partyName      String         @map("party_name")
  kind           OpenItemKind
  documentDate   DateTime       @map("document_date") @db.Date
  dueDate        DateTime?      @map("due_date") @db.Date
  currency       Currency
  fxRate         Decimal?       @map("fx_rate") @db.Decimal(18, 6)
  originalAmount Decimal        @map("original_amount") @db.Decimal(18, 4)
  remaining      Decimal        @db.Decimal(18, 4)
  settlementMode SettlementMode @default(CASH) @map("settlement_mode")
  sourceType     String         @map("source_type")
  sourceId       String         @default("") @map("source_id")
  reference      String         @default("")
  memo           String         @default("")
  status         OpenItemStatus @default(OPEN)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  customer    Customer?            @relation(fields: [customerId], references: [id])
  supplier    Supplier?            @relation(fields: [supplierId], references: [id])
  borrower    Borrower?            @relation(fields: [borrowerId], references: [id])
  location    Location?            @relation(fields: [locationId], references: [id])
  employee    Employee?            @relation(fields: [employeeId], references: [id])
  allocations OpenItemAllocation[]

  @@index([companyId, party, status])
  @@index([companyId, kind])
  @@index([customerId])
  @@index([supplierId])
  @@index([borrowerId, currency, status])
  @@index([companyId, sourceType, sourceId])
  @@map("open_items")
}

model OpenItemAllocation {
  id               String   @id @default(cuid())
  companyId        String   @default("tradivia") @map("company_id")
  openItemId       String   @map("open_item_id")
  amount           Decimal  @db.Decimal(18, 4)
  settlementFxRate Decimal? @map("settlement_fx_rate") @db.Decimal(18, 6)
  fxDifference     Decimal  @default(0) @map("fx_difference") @db.Decimal(18, 4)
  sourceType       String   @map("source_type")
  sourceId         String   @default("") @map("source_id")
  memo             String   @default("")
  createdAt        DateTime @default(now()) @map("created_at")

  openItem OpenItem @relation(fields: [openItemId], references: [id], onDelete: Cascade)

  @@index([openItemId])
  @@index([companyId, sourceType, sourceId])
  @@map("open_item_allocations")
}

model OpeningEntry {
  id           String    @id @default(cuid())
  companyId    String    @unique @default("tradivia") @map("company_id")
  balanceDate  DateTime  @map("balance_date") @db.Date
  entryDate    DateTime  @map("entry_date") @db.Date
  allowance    Decimal   @default(0) @db.Decimal(18, 4)
  reference    String    @default("")
  employeeId   String    @map("employee_id")
  postedAt     DateTime? @map("posted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  employee Employee           @relation(fields: [employeeId], references: [id])
  accounts OpeningAccountLine[]
  stock    OpeningStockLine[]

  @@index([employeeId])
  @@map("opening_entries")
}

model OpeningAccountLine {
  id        String   @id @default(cuid())
  entryId   String   @map("entry_id")
  code      String
  currency  Currency
  debit     Decimal  @default(0) @db.Decimal(18, 4)
  credit    Decimal  @default(0) @db.Decimal(18, 4)
  memo      String   @default("")
  sortOrder Int      @map("sort_order")

  entry OpeningEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("opening_account_lines")
}

model OpeningStockLine {
  id          String  @id @default(cuid())
  entryId     String  @map("entry_id")
  productId   String  @map("product_id")
  warehouseId String  @map("warehouse_id")
  quantity    Decimal @db.Decimal(18, 4)
  unitCost    Decimal @default(0) @map("unit_cost") @db.Decimal(18, 4)

  entry     OpeningEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id])
  warehouse Warehouse    @relation(fields: [warehouseId], references: [id])

  @@index([entryId])
  @@index([productId])
  @@map("opening_stock_lines")
}

enum LeadStatus {
  OPEN
  CONVERTED
  LOST
}

enum OpportunityStage {
  NEW
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  MEETING
  TASK
}

enum ActivityStatus {
  OPEN
  DONE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Lead {
  id          String     @id @default(cuid())
  companyId   String     @default("tradivia") @map("company_id")
  name        String
  phone       String     @default("")
  address     String     @default("")
  notes       String     @default("")
  status      LeadStatus @default(OPEN)
  ownerId     String     @map("owner_id")
  customerId  String?    @map("customer_id")
  convertedAt DateTime?  @map("converted_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  owner      Employee   @relation("LeadOwner", fields: [ownerId], references: [id])
  customer   Customer?  @relation(fields: [customerId], references: [id])
  activities Activity[]

  @@index([companyId, status])
  @@index([ownerId])
  @@index([customerId])
  @@map("leads")
}

model Opportunity {
  id             String           @id @default(cuid())
  companyId      String           @default("tradivia") @map("company_id")
  customerId     String           @map("customer_id")
  title          String
  stage          OpportunityStage @default(NEW)
  expectedAmount Decimal          @default(0) @map("expected_amount") @db.Decimal(18, 4)
  probability    Int              @default(0)
  currency       Currency         @default(USD)
  ownerId        String           @map("owner_id")
  closeDate      DateTime?        @map("close_date") @db.Date
  lossReason     String           @default("") @map("loss_reason")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  customer   Customer   @relation(fields: [customerId], references: [id])
  owner      Employee   @relation("OpportunityOwner", fields: [ownerId], references: [id])
  activities Activity[]
  quotes     Quote[]

  @@index([companyId, stage])
  @@index([customerId])
  @@index([ownerId])
  @@map("opportunities")
}

model Activity {
  id            String         @id @default(cuid())
  companyId     String         @default("tradivia") @map("company_id")
  type          ActivityType
  title         String
  dueAt         DateTime       @map("due_at")
  status        ActivityStatus @default(OPEN)
  notes         String         @default("")
  ownerId       String         @map("owner_id")
  customerId    String?        @map("customer_id")
  leadId        String?        @map("lead_id")
  opportunityId String?        @map("opportunity_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  owner       Employee     @relation("ActivityOwner", fields: [ownerId], references: [id])
  customer    Customer?    @relation(fields: [customerId], references: [id])
  lead        Lead?        @relation(fields: [leadId], references: [id])
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id])

  @@index([companyId, status, dueAt])
  @@index([ownerId])
  @@index([customerId])
  @@map("activities")
}

model Quote {
  id             String      @id @default(cuid())
  companyId      String      @default("tradivia") @map("company_id")
  number         Int
  version        Int         @default(1)
  parentId       String?     @map("parent_id")
  customerId     String      @map("customer_id")
  opportunityId  String?     @map("opportunity_id")
  status         QuoteStatus @default(DRAFT)
  currency       Currency
  fxRate         Decimal?    @map("fx_rate") @db.Decimal(18, 6)
  validUntil     DateTime?   @map("valid_until") @db.Date
  notes          String      @default("")
  subtotal       Decimal     @default(0) @db.Decimal(18, 4)
  discount       Decimal     @default(0) @db.Decimal(18, 4)
  total          Decimal     @default(0) @db.Decimal(18, 4)
  employeeId     String      @map("employee_id")
  salesInvoiceId String?     @unique @map("sales_invoice_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  parent       Quote?        @relation("QuoteVersions", fields: [parentId], references: [id])
  versions     Quote[]       @relation("QuoteVersions")
  customer     Customer      @relation(fields: [customerId], references: [id])
  opportunity  Opportunity?  @relation(fields: [opportunityId], references: [id])
  employee     Employee      @relation(fields: [employeeId], references: [id])
  salesInvoice SalesInvoice? @relation(fields: [salesInvoiceId], references: [id])
  lines        QuoteLine[]

  @@unique([companyId, number, version])
  @@index([companyId, status])
  @@index([customerId])
  @@index([employeeId])
  @@index([opportunityId])
  @@map("quotes")
}

model QuoteLine {
  id          String      @id @default(cuid())
  quoteId     String      @map("quote_id")
  productId   String      @map("product_id")
  productName String      @map("product_name")
  sku         String      @default("")
  unit        ProductUnit
  quantity    Decimal     @db.Decimal(18, 4)
  unitPrice   Decimal     @map("unit_price") @db.Decimal(18, 4)
  discount    Decimal     @default(0) @db.Decimal(18, 4)
  lineTotal   Decimal     @map("line_total") @db.Decimal(18, 4)
  sortOrder   Int         @map("sort_order")

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@index([productId])
  @@map("quote_lines")
}
