// UNI GATE ERP — Finance module (multi-tenant via companyId).
// Default dev tenant: tradivia (pilot customer). Product owner: UNI GATE Services.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GENERAL_MANAGER
  SUPERVISOR
  EMPLOYEE
  MONITOR
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum Currency {
  USD
  SYP
  EUR
  GBP
  TRY
  AED
  SAR
  JOD
  LBP
  IQD
  EGP
  QAR
  KWD
  CHF
  CAD
  CNY
}

/// Cash funds only: الخزائن، المحافظ الرقمية، البنوك.
/// Borrower custody is a receivable sub-ledger under account 1300 (see OpenItemKind.CUSTODY), never a fund.
enum FundType {
  VAULT
  SHAM_CASH
  BANK
}

enum TransactionStatus {
  COMPLETED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  DELETED
}

enum ExchangeType {
  BUY
  SELL
}

/// ISSUE: صرف عهدة من صندوق (Dr 1300 / Cr صندوق). RETURN: استرداد عهدة إلى صندوق.
/// OUTCOME: صادر من رصيد المستلف. EXCHANGE: تصريف عملة داخل الرصيد.
enum AdvanceType {
  OUTCOME
  EXCHANGE
  ISSUE
  RETURN
}

enum AuditActionType {
  UPDATE
  DELETE
}

enum AuditRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DIRECT
}

enum NotificationStatus {
  UNREAD
  READ
}

model Location {
  id        String       @id @default(cuid())
  companyId String       @default("tradivia") @map("company_id")
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  employees        Employee[]
  incomes          Income[]
  outcomes         Outcome[]
  exchanges        Exchange[]
  transfers        Transfer[]
  advances         Advance[]
  openingBalances  OpeningBalance[]
  auditTrail       AuditTrail[]
  notifications    Notification[]
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  journalEntries   JournalEntry[]
  inventoryAssessments InventoryAssessment[]
  costCenter       CostCenter?
  openItems        OpenItem[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("locations")
}

model Employee {
  id            String       @id @default(cuid())
  companyId     String       @default("tradivia") @map("company_id")
  name          String
  passwordHash  String       @map("password_hash")
  role          Role
  /// Null for GENERAL_MANAGER and MONITOR (they see every office).
  locationId    String?      @map("location_id")
  accountStatus RecordStatus @default(ACTIVE) @map("account_status")
  sessionLocked Boolean      @default(false) @map("session_locked")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  location               Location?                @relation(fields: [locationId], references: [id])
  incomes                Income[]
  outcomes               Outcome[]
  exchanges              Exchange[]
  transfers              Transfer[]
  advances               Advance[]
  openingBalances        OpeningBalance[]
  salesInvoices          SalesInvoice[]
  voidedInvoices         SalesInvoice[]           @relation("InvoiceVoidedBy")
  inventoryAssessments   InventoryAssessment[]
  salesPayments          SalesInvoicePayment[]
  purchaseInvoices       PurchaseInvoice[]
  voidedPurchases        PurchaseInvoice[]        @relation("PurchaseVoidedBy")
  purchasePayments       PurchaseInvoicePayment[]
  auditRequests          AuditTrail[]             @relation("AuditRequester")
  auditDecisions         AuditTrail[]             @relation("AuditSupervisor")
  notifications          Notification[]           @relation("NotificationEmployee")
  requestedNotifications Notification[]           @relation("NotificationRequester")
  stockMovements         StockMovement[]
  journalEntries         JournalEntry[]
  ownedLeads             Lead[]                   @relation("LeadOwner")
  ownedOpportunities     Opportunity[]            @relation("OpportunityOwner")
  ownedActivities        Activity[]               @relation("ActivityOwner")
  quotes                 Quote[]
  openingEntries         OpeningEntry[]
  openItems              OpenItem[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([role])
  @@index([locationId])
  @@map("employees")
}

model Borrower {
  id        String       @id @default(cuid())
  companyId String       @default("tradivia") @map("company_id")
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  advances  Advance[]
  openItems OpenItem[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("borrowers")
}

model Project {
  id        String       @id @default(cuid())
  companyId String       @default("tradivia") @map("company_id")
  name      String
  status    RecordStatus @default(ACTIVE)
  /// Places the project appears: INCOME | OUTCOME | LOANS | REPORTS
  showIn    String[]     @default([]) @map("show_in")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  incomes    Income[]
  outcomes   Outcome[]
  advances   Advance[]
  costCenter CostCenter?
  journalLines JournalLine[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("projects")
}

model Bank {
  id        String       @id @default(cuid())
  companyId String       @default("tradivia") @map("company_id")
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  incomes         Income[]
  outcomes        Outcome[]
  exchanges       Exchange[]
  transfersFrom   Transfer[]       @relation("TransferFromBank")
  transfersTo     Transfer[]       @relation("TransferToBank")
  advances        Advance[]
  openingBalances OpeningBalance[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("banks")
}

model Income {
  id              String            @id @default(cuid())
  companyId       String            @default("tradivia") @map("company_id")
  operationNumber Int               @map("operation_number")
  transactionDate DateTime          @map("transaction_date") @db.Date
  systemDate      DateTime          @default(now()) @map("system_date")
  projectId       String?           @map("project_id")
  description     String            @default("")
  fund            FundType
  bankId          String?           @map("bank_id")
  sender          String            @default("")
  receiver        String            @default("")
  currency        Currency
  quantity        Decimal?          @db.Decimal(18, 4)
  amount          Decimal           @db.Decimal(18, 4)
  total           Decimal           @db.Decimal(18, 4)
  fxRate          Decimal?          @map("fx_rate") @db.Decimal(18, 6)
  attachments     String            @default("")
  notes           String            @default("")
  employeeId      String            @map("employee_id")
  locationId      String?           @map("location_id")
  status          TransactionStatus @default(COMPLETED)
  reference       String
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  project      Project?             @relation(fields: [projectId], references: [id])
  bank         Bank?                @relation(fields: [bankId], references: [id])
  employee     Employee             @relation(fields: [employeeId], references: [id])
  location     Location?            @relation(fields: [locationId], references: [id])
  salesPayment SalesInvoicePayment?

  @@unique([companyId, reference])
  @@index([companyId, transactionDate])
  @@index([companyId, status])
  @@index([employeeId])
  @@index([projectId])
  @@index([locationId])
  @@map("incomes")
}

model Outcome {
  id              String            @id @default(cuid())
  companyId       String            @default("tradivia") @map("company_id")
  operationNumber Int               @map("operation_number")
  transactionDate DateTime          @map("transaction_date") @db.Date
  systemDate      DateTime          @default(now()) @map("system_date")
  projectId       String?           @map("project_id")
  description     String            @default("")
  fund            FundType
  bankId          String?           @map("bank_id")
  deliverer       String            @default("")
  receiver        String            @default("")
  currency        Currency
  quantity        Decimal?          @db.Decimal(18, 4)
  amount          Decimal           @db.Decimal(18, 4)
  total           Decimal           @db.Decimal(18, 4)
  fxRate          Decimal?          @map("fx_rate") @db.Decimal(18, 6)
  attachments     String            @default("")
  notes           String            @default("")
  employeeId      String            @map("employee_id")
  locationId      String?           @map("location_id")
  status          TransactionStatus @default(COMPLETED)
  reference       String
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  project         Project?                @relation(fields: [projectId], references: [id])
  bank            Bank?                   @relation(fields: [bankId], references: [id])
  employee        Employee                @relation(fields: [employeeId], references: [id])
  location        Location?               @relation(fields: [locationId], references: [id])
  purchasePayment PurchaseInvoicePayment?

  @@unique([companyId, reference])
  @@index([companyId, transactionDate])
  @@index([companyId, status])
  @@index([employeeId])
  @@index([projectId])
  @@index([locationId])
  @@map("outcomes")
}

model Exchange {
  id               String            @id @default(cuid())
  companyId        String            @default("tradivia") @map("company_id")
  operationNumber  Int               @map("operation_number")
  transactionDate  DateTime          @map("transaction_date") @db.Date
  systemDate       DateTime          @default(now()) @map("system_date")
  fund             FundType
  bankId           String?           @map("bank_id")
  exchangeType     ExchangeType      @map("exchange_type")
  paidCurrency     Currency          @map("paid_currency")
  receivedCurrency Currency          @map("received_currency")
  exchangeAmount   Decimal           @map("exchange_amount") @db.Decimal(18, 4)
  amountCurrency   Currency          @map("amount_currency")
  exchangeRate     Decimal           @map("exchange_rate") @db.Decimal(18, 6)
  total            Decimal           @db.Decimal(18, 4)
  attachments      String            @default("")
  notes            String            @default("")
  employeeId       String            @map("employee_id")
  locationId       String?           @map("location_id")
  status           TransactionStatus @default(COMPLETED)
  reference        String
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  bank     Bank?     @relation(fields: [bankId], references: [id])
  employee Employee  @relation(fields: [employeeId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@unique([companyId, reference])
  @@index([companyId, transactionDate])
  @@index([companyId, status])
  @@index([employeeId])
  @@index([locationId])
  @@map("exchanges")
}

model Transfer {
  id              String            @id @default(cuid())
  companyId       String            @default("tradivia") @map("company_id")
  operationNumber Int               @map("operation_number")
  transactionDate DateTime          @map("transaction_date") @db.Date
  systemDate      DateTime          @default(now()) @map("system_date")
  fromFund        FundType          @map("from_fund")
  toFund          FundType          @map("to_fund")
  fromBankId      String?           @map("from_bank_id")
  toBankId        String?           @map("to_bank_id")
  currency        Currency
  fxRate          Decimal?          @map("fx_rate") @db.Decimal(18, 6)
  amount          Decimal           @db.Decimal(18, 4)
  attachments     String            @default("")
  notes           String            @default("")
  employeeId      String            @map("employee_id")
  locationId      String?           @map("location_id")
  status          TransactionStatus @default(COMPLETED)
  reference       String
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  fromBank Bank?     @relation("TransferFromBank", fields: [fromBankId], references: [id])
  toBank   Bank?     @relation("TransferToBank", fields: [toBankId], references: [id])
  employee Employee  @relation(fields: [employeeId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@unique([companyId, reference])
  @@index([companyId, transactionDate])
  @@index([companyId, status])
  @@index([employeeId])
  @@index([locationId])
  @@map("transfers")
}

model Advance {
  id              String            @id @default(cuid())
  companyId       String            @default("tradivia") @map("company_id")
  operationNumber Int               @map("operation_number")
  transactionDate DateTime          @map("transaction_date") @db.Date
  systemDate      DateTime          @default(now()) @map("system_date")
  borrowerId      String            @map("borrower_id")
  advanceType     AdvanceType       @map("advance_type")
  projectId       String?           @map("project_id")
  description     String            @default("")
  receiver        String            @default("")
  currency        Currency
  quantity        Decimal?          @db.Decimal(18, 4)
  amount          Decimal           @db.Decimal(18, 4)
  exchangeRate    Decimal?          @map("exchange_rate") @db.Decimal(18, 6)
  total           Decimal           @db.Decimal(18, 4)
  fromCurrency    Currency?         @map("from_currency")
  toCurrency      Currency?         @map("to_currency")
  /// Cash side of an ISSUE or RETURN voucher. Null for OUTCOME and EXCHANGE (they never touch a fund).
  fund            FundType?
  bankId          String?           @map("bank_id")
  attachments     String            @default("")
  notes           String            @default("")
  employeeId      String            @map("employee_id")
  locationId      String?           @map("location_id")
  status          TransactionStatus @default(COMPLETED)
  reference       String
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  bank     Bank?     @relation(fields: [bankId], references: [id])
  borrower Borrower  @relation(fields: [borrowerId], references: [id])
  project  Project?  @relation(fields: [projectId], references: [id])
  employee Employee  @relation(fields: [employeeId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@unique([companyId, reference])
  @@index([companyId, transactionDate])
  @@index([companyId, status])
  @@index([employeeId])
  @@index([borrowerId])
  @@index([locationId])
  @@map("advances")
}

model OpeningBalance {
  id              String            @id @default(cuid())
  companyId       String            @default("tradivia") @map("company_id")
  operationNumber Int               @map("operation_number")
  transactionDate DateTime          @map("transaction_date") @db.Date
  systemDate      DateTime          @default(now()) @map("system_date")
  fund            FundType
  bankId          String?           @map("bank_id")
  currency        Currency
  fxRate          Decimal?          @map("fx_rate") @db.Decimal(18, 6)
  amount          Decimal           @db.Decimal(18, 4)
  notes           String            @default("")
  employeeId      String            @map("employee_id")
  locationId      String?           @map("location_id")
  status          TransactionStatus @default(COMPLETED)
  reference       String
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  bank     Bank?     @relation(fields: [bankId], references: [id])
  employee Employee  @relation(fields: [employeeId], references: [id])
  location Location? @relation(fields: [locationId], references: [id])

  @@unique([companyId, reference])
  @@index([companyId, fund, currency])
  @@index([employeeId])
  @@index([locationId])
  @@map("opening_balances")
}

model AuditTrail {
  id                 String             @id @default(cuid())
  companyId          String             @default("tradivia") @map("company_id")
  originalReference  String             @map("original_reference")
  requesterId        String             @map("requester_id")
  actionType         AuditActionType    @map("action_type")
  oldDetails         Json               @map("old_details")
  newDetails         Json               @map("new_details")
  requestedAt        DateTime           @default(now()) @map("requested_at")
  requestStatus      AuditRequestStatus @default(PENDING) @map("request_status")
  supervisorId       String?            @map("supervisor_id")
  supervisorDecision String             @default("") @map("supervisor_decision")
  reason             String             @default("")
  locationId         String?            @map("location_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  requester  Employee  @relation("AuditRequester", fields: [requesterId], references: [id])
  supervisor Employee? @relation("AuditSupervisor", fields: [supervisorId], references: [id])
  location   Location? @relation(fields: [locationId], references: [id])

  @@index([companyId, requestStatus])
  @@index([originalReference])
  @@index([requesterId])
  @@index([locationId])
  @@map("audit_trail")
}

model Notification {
  id          String             @id @default(cuid())
  companyId   String             @default("tradivia") @map("company_id")
  employeeId  String             @map("employee_id")
  message     String
  occurredAt  DateTime           @default(now()) @map("occurred_at")
  status      NotificationStatus @default(UNREAD)
  section     String             @default("")
  requestId   String             @default("") @map("request_id")
  actionType  String             @default("") @map("action_type")
  reference   String             @default("")
  requesterId String?            @map("requester_id")
  locationId  String?            @map("location_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  employee  Employee  @relation("NotificationEmployee", fields: [employeeId], references: [id])
  requester Employee? @relation("NotificationRequester", fields: [requesterId], references: [id])
  location  Location? @relation(fields: [locationId], references: [id])

  @@index([companyId, employeeId, status])
  @@index([reference])
  @@index([locationId])
  @@map("notifications")
}

enum ProductUnit {
  PIECE
  KG
  METER
  LITER
  BOX
  SET
}

enum StockMoveType {
  IN
  OUT
  ADJUST
}

enum StockSourceType {
  MANUAL
  SALES_ISSUE
  SALES_RETURN
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  OPENING
}

enum SalesInvoiceStatus {
  DRAFT
  POSTED
  VOID
}

enum DiscountMode {
  AMOUNT
  PERCENT
}

enum SalesPaymentStatus {
  POSTED
  REVERSED
}

model Warehouse {
  id        String       @id @default(cuid())
  companyId String       @default("tradivia") @map("company_id")
  name      String
  isDefault Boolean      @default(false) @map("is_default")
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  movements        StockMovement[]
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  openingStock     OpeningStockLine[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("warehouses")
}

model Product {
  id          String       @id @default(cuid())
  companyId   String       @default("tradivia") @map("company_id")
  name        String
  sku         String
  barcode     String       @default("")
  unit        ProductUnit  @default(PIECE)
  costPrice   Decimal?     @map("cost_price") @db.Decimal(18, 4)
  salePrice   Decimal?     @map("sale_price") @db.Decimal(18, 4)
  unitNrv     Decimal?     @map("unit_nrv") @db.Decimal(18, 4)
  nrvCurrency Currency?    @map("nrv_currency")
  inventoryAllowance Decimal @default(0) @map("inventory_allowance") @db.Decimal(18, 4)
  minQuantity Decimal      @default(0) @map("min_quantity") @db.Decimal(18, 4)
  imagePath   String       @default("") @map("image_path")
  imageMime   String       @default("") @map("image_mime")
  notes       String       @default("")
  status      RecordStatus @default(ACTIVE)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  movements      StockMovement[]
  salesLines     SalesInvoiceLine[]
  purchaseLines  PurchaseInvoiceLine[]
  nrvLines       InventoryAssessmentLine[]
  quoteLines     QuoteLine[]
  openingStock   OpeningStockLine[]

  @@unique([companyId, name])
  @@unique([companyId, sku])
  @@index([companyId])
  @@index([companyId, status])
  @@map("products")
}

/// Quantity is the signed stock effect: IN positive, OUT negative, ADJUST is the delta to the counted quantity.
model StockMovement {
  id           String          @id @default(cuid())
  companyId    String          @default("tradivia") @map("company_id")
  reference    String
  productId    String          @map("product_id")
  warehouseId  String          @map("warehouse_id")
  moveType     StockMoveType   @map("move_type")
  quantity     Decimal         @db.Decimal(18, 4)
  notes        String          @default("")
  sourceType   StockSourceType @default(MANUAL) @map("source_type")
  sourceId     String          @default("") @map("source_id")
  sourceLineId String          @default("") @map("source_line_id")
  employeeId   String          @map("employee_id")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  employee  Employee  @relation(fields: [employeeId], references: [id])

  @@unique([companyId, reference])
  @@index([companyId, warehouseId, productId])
  @@index([productId])
  @@index([employeeId])
  @@index([createdAt])
  @@index([companyId, sourceId])
  @@map("stock_movements")
}

model Customer {
  id              String       @id @default(cuid())
  companyId       String       @default("tradivia") @map("company_id")
  name            String
  phone           String       @default("")
  email           String       @default("")
  city            String       @default("")
  address         String       @default("")
  taxNumber       String       @default("") @map("tax_number")
  paymentTermDays Int          @default(0) @map("payment_term_days")
  notes           String       @default("")
  status          RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  invoices      SalesInvoice[]
  openItems     OpenItem[]
  leads         Lead[]
  opportunities Opportunity[]
  activities    Activity[]
  quotes        Quote[]

  @@unique([companyId, name])
  @@index([companyId, status])
  @@map("customers")
}

/// Commercial sale. Stock moves only when POSTED. Cash is a separate payment that creates an income.
model SalesInvoice {
  id              String             @id @default(cuid())
  companyId       String             @default("tradivia") @map("company_id")
  number          Int
  reference       String
  transactionDate DateTime           @map("transaction_date") @db.Date
  customerId      String             @map("customer_id")
  customerName       String             @map("customer_name")
  warehouseId        String             @map("warehouse_id")
  warehouseName      String             @map("warehouse_name")
  currency           Currency
  fxRate             Decimal?           @map("fx_rate") @db.Decimal(18, 6)
  dueDate            DateTime?          @map("due_date") @db.Date
  customerReference  String             @default("") @map("customer_reference")
  notes              String             @default("")
  discountMode       DiscountMode       @default(AMOUNT) @map("discount_mode")
  discountRate       Decimal            @default(0) @map("discount_rate") @db.Decimal(18, 4)
  discount           Decimal            @default(0) @db.Decimal(18, 4)
  subtotal        Decimal            @default(0) @db.Decimal(18, 4)
  total           Decimal            @default(0) @db.Decimal(18, 4)
  status          SalesInvoiceStatus @default(DRAFT)
  employeeId      String             @map("employee_id")
  locationId      String?            @map("location_id")
  postedAt        DateTime?          @map("posted_at")
  voidedAt        DateTime?          @map("voided_at")
  voidReason      String             @default("") @map("void_reason")
  voidedById      String?            @map("voided_by_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  customer  Customer              @relation(fields: [customerId], references: [id])
  warehouse Warehouse             @relation(fields: [warehouseId], references: [id])
  employee  Employee              @relation(fields: [employeeId], references: [id])
  location  Location?             @relation(fields: [locationId], references: [id])
  voidedBy  Employee?             @relation("InvoiceVoidedBy", fields: [voidedById], references: [id])
  lines     SalesInvoiceLine[]
  payments  SalesInvoicePayment[]
  quote     Quote?

  @@unique([companyId, number])
  @@unique([companyId, reference])
  @@index([companyId, status, transactionDate])
  @@index([customerId])
  @@index([warehouseId])
  @@index([employeeId])
  @@index([locationId])
