  notes           String    @default("")
  employeeId      String    @map("employee_id")
  locationId      String?   @map("location_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  employee Employee                  @relation(fields: [employeeId], references: [id])
  location Location?                 @relation(fields: [locationId], references: [id])
  lines    InventoryAssessmentLine[]

  @@unique([companyId, reference])
  @@index([companyId, transactionDate])
  @@index([employeeId])
  @@index([locationId])
  @@map("inventory_assessments")
}

model InventoryAssessmentLine {
  id               String   @id @default(cuid())
  assessmentId     String   @map("assessment_id")
  productId        String   @map("product_id")
  quantity         Decimal  @db.Decimal(18, 4)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(18, 4)
  unitNrv          Decimal  @map("unit_nrv") @db.Decimal(18, 4)
  allowanceBefore  Decimal  @map("allowance_before") @db.Decimal(18, 4)
  allowanceAfter   Decimal  @map("allowance_after") @db.Decimal(18, 4)

  assessment InventoryAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  product    Product              @relation(fields: [productId], references: [id])

  @@index([assessmentId])
  @@index([productId])
  @@map("inventory_assessment_lines")
}

model SalesInvoicePayment {
  id         String             @id @default(cuid())
  companyId  String             @default("tradivia") @map("company_id")
  invoiceId  String             @map("invoice_id")
  incomeId   String             @unique @map("income_id")
  amount     Decimal            @db.Decimal(18, 4)
  status     SalesPaymentStatus @default(POSTED)
  reason     String             @default("")
  employeeId String             @map("employee_id")
