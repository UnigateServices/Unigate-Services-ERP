// Unigate foundation. This is not the TRADIVIA finance schema.
//
// Login names
// - Platform operator username is User.username. It is required for kind PLATFORM
//   and forbidden for kind MEMBER (see the CHECK constraint in the foundation migration).
//   Uniqueness is a partial index on lower(username) WHERE kind = 'PLATFORM'.
// - Customer username is Membership.username. Uniqueness is (company_id, lower(username)),
//   so the same name may exist in another company.
// - A platform username and a customer username are different columns. They may match
//   as text without being the same account.
//
// Subscription
// - Company.status SUSPENDED means a person suspended the company. It is not set
//   automatically when the date passes.
// - expiresOn is the last valid calendar day in Asia/Damascus. The day itself still
//   allows member access. The next calendar day is SUBSCRIPTION_EXPIRED at login time.
//   That result is computed. It is not a status value.
//
// Modules
// - CompanyModule.enabled is the tenant switch.
// - Whether a module is implemented (ready) lives in application code, not in this table.
//
// Sessions
// - User.authVersion increments when the password changes or an administrator resets it.
//   A signed session carries that version and is rejected when it is older.
//   Role and permission checks still read the current role row. They are not frozen
//   inside authVersion.
//
// Company integrity
// - Role and Location keep their primary key on id, and also a unique (companyId, id).
//   That extra key lets Membership name the company in the foreign key.
// - Membership (companyId, roleId) references Role (companyId, id).
// - Membership (companyId, locationId) references Location (companyId, id).
//   locationId null is all-branch access. PostgreSQL does not check that foreign
//   key when locationId is null.
// - A referenced location is not set null on delete. Branches are deactivated.
//   ON DELETE SET NULL on the composite key would also clear companyId.
// - Membership also has a unique (companyId, id), so later tables (finance) can name
//   the acting member together with the company in one foreign key.
// - A trigger keeps role scope and membership location in agreement:
//   ALL_BRANCHES has no location, BRANCH and OWN have one. See migration
//   20261023090000_role_permissions.
//
// Permissions
// - RolePermission holds one level per role and area. A missing row is NONE.
//   Areas are listed in PERMISSION_AREAS in @unigate/shared, not in a database enum,
//   so a new module adds no column or enum value here.
// - Administration areas (users, branches, roles) accept READ or WRITE only.
//   CHECK constraints enforce that, and that NONE is never stored.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserKind {
  PLATFORM
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum RecordStatus {
  ACTIVE
  INACTIVE
}

enum VisibilityScope {
  OWN
  BRANCH
  ALL_BRANCHES
}

enum ModuleKey {
  finance
  exchange
  gold
  aviation
  engineering
  hr
}

/// NONE < READ < WRITE < APPROVE < ADMIN. Each level includes the ones before it.
enum PermissionLevel {
  NONE
  READ
  WRITE
  APPROVE
  ADMIN
}

enum AuditAction {
  ENTER
  CREATE
  UPDATE
  DELETE
}

model User {
  id               String     @id @default(cuid())
  kind             UserKind
  /// Platform login name. Null for every MEMBER. See schema header.
  username         String?
  passwordHash     String     @map("password_hash")
  email            String?
  phone            String?
  /// Shown in the shell. Not used as a login name.
  name             String
  status           UserStatus @default(ACTIVE)
  /// Bumped on password change or administrator reset. Carried by the signed session.
  authVersion      Int        @default(1) @map("auth_version")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  membership   Membership?
  auditEntries AuditEntry[]

  /// Platform login names are unique per kind. MEMBER rows keep username null,
  /// and PostgreSQL allows many nulls in this unique key.
  @@unique([kind, username])
  @@index([kind])
  @@map("users")
}

model Company {
  id        String        @id @default(cuid())
  name      String
  code      String        @unique
  /// Manual suspension. Independent from expiresOn.
  status    CompanyStatus @default(ACTIVE)
  priceUsd  Decimal       @map("price_usd") @db.Decimal(12, 2)
  /// Last valid calendar day in Asia/Damascus.
  expiresOn DateTime      @map("expires_on") @db.Date
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  locations       Location[]
  roles           Role[]
  memberships     Membership[]
  modules         CompanyModule[]
  auditEntries    AuditEntry[]
  rolePermissions RolePermission[]

  // Finance (phase F2)
  borrowers                Borrower[]
  projects                 Project[]
  banks                    Bank[]
  incomes                  Income[]
  outcomes                 Outcome[]
  exchanges                Exchange[]
  transfers                Transfer[]
  advances                 Advance[]
  openingBalances          OpeningBalance[]
  auditTrails              AuditTrail[]
  notifications            Notification[]
  warehouses               Warehouse[]
  products                 Product[]
  stockMovements           StockMovement[]
  customers                Customer[]
  salesInvoices            SalesInvoice[]
  salesInvoiceLines        SalesInvoiceLine[]
  inventoryAssessments     InventoryAssessment[]
  inventoryAssessmentLines InventoryAssessmentLine[]
  salesInvoicePayments     SalesInvoicePayment[]
  suppliers                Supplier[]
  purchaseInvoices         PurchaseInvoice[]
  purchaseInvoiceLines     PurchaseInvoiceLine[]
  accounts                 Account[]
  journalEntries           JournalEntry[]
  journalLines             JournalLine[]
  costCenters              CostCenter[]
  purchaseInvoicePayments  PurchaseInvoicePayment[]
  accountingPolicies       AccountingPolicy[]
  fxRevaluations           FxRevaluation[]
  fiscalYears              FiscalYear[]
  fiscalPeriods            FiscalPeriod[]
  budgets                  Budget[]
  budgetLines              BudgetLine[]
  companyCurrencies        CompanyCurrency[]
  dailyRates               DailyRate[]
  openItems                OpenItem[]
  openItemAllocations      OpenItemAllocation[]
  openingEntries           OpeningEntry[]
  openingAccountLines      OpeningAccountLine[]
  openingStockLines        OpeningStockLine[]
  leads                    Lead[]
  opportunities            Opportunity[]
  activities               Activity[]
  quotes                   Quote[]
  quoteLines               QuoteLine[]

  @@map("companies")
}

model Location {
  id        String       @id @default(cuid())
  companyId String       @map("company_id")
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  company     Company      @relation(fields: [companyId], references: [id])
  memberships Membership[]

  // Finance (phase F2)
  incomes              Income[]
  outcomes             Outcome[]
  exchanges            Exchange[]
  transfers            Transfer[]
  advances             Advance[]
  openingBalances      OpeningBalance[]
  auditTrail           AuditTrail[]
  notifications        Notification[]
  salesInvoices        SalesInvoice[]
  purchaseInvoices     PurchaseInvoice[]
  journalEntries       JournalEntry[]
  inventoryAssessments InventoryAssessment[]
  costCenter           CostCenter?
  openItems            OpenItem[]

  @@unique([companyId, name])
  @@unique([companyId, id])
  @@index([companyId])
  @@map("locations")
}

model Role {
  id                     String          @id @default(cuid())
  companyId              String          @map("company_id")
  key                    String
  name                   String
  visibilityScope        VisibilityScope @map("visibility_scope")
  editRequiresApproval   Boolean         @default(false) @map("edit_requires_approval")
  deleteRequiresApproval Boolean         @default(false) @map("delete_requires_approval")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  company     Company          @relation(fields: [companyId], references: [id])
  memberships Membership[]
  permissions RolePermission[]

  @@unique([companyId, key])
  @@unique([companyId, id])
  @@index([companyId])
  @@map("roles")
}

model Membership {
  id         String   @id @default(cuid())
  userId     String   @unique @map("user_id")
  companyId  String   @map("company_id")
  /// Customer login name. Unique inside this company only.
  username   String
  roleId     String   @map("role_id")
  locationId String?  @map("location_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id])
  company  Company   @relation(fields: [companyId], references: [id])
  role     Role      @relation(fields: [companyId, roleId], references: [companyId, id])
  location Location? @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)

  // Finance (phase F2)
  incomes                Income[]
  outcomes               Outcome[]
  exchanges              Exchange[]
  transfers              Transfer[]
  advances               Advance[]
  openingBalances        OpeningBalance[]
  salesInvoices          SalesInvoice[]
  voidedInvoices         SalesInvoice[]           @relation("InvoiceVoidedBy")
  inventoryAssessments   InventoryAssessment[]
  salesPayments          SalesInvoicePayment[]
  purchaseInvoices       PurchaseInvoice[]
  voidedPurchases        PurchaseInvoice[]        @relation("PurchaseVoidedBy")
  purchasePayments       PurchaseInvoicePayment[]
  auditRequests          AuditTrail[]             @relation("AuditRequester")
  auditDecisions         AuditTrail[]             @relation("AuditSupervisor")
  notifications          Notification[]           @relation("NotificationEmployee")
  requestedNotifications Notification[]           @relation("NotificationRequester")
  stockMovements         StockMovement[]
  journalEntries         JournalEntry[]
  ownedLeads             Lead[]                   @relation("LeadOwner")
  ownedOpportunities     Opportunity[]            @relation("OpportunityOwner")
  ownedActivities        Activity[]               @relation("ActivityOwner")
  quotes                 Quote[]
  openingEntries         OpeningEntry[]
  openItems              OpenItem[]

  @@unique([companyId, username])
  @@unique([companyId, id])
  @@index([companyId])
  @@index([roleId])
  @@index([locationId])
  @@map("memberships")
}

model RolePermission {
  id        String          @id @default(cuid())
  companyId String          @map("company_id")
  roleId    String          @map("role_id")
  /// Key from PERMISSION_AREAS in @unigate/shared.
  area      String
  /// Never NONE in a stored row. A missing row is NONE.
  level     PermissionLevel
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])
  role    Role    @relation(fields: [companyId, roleId], references: [companyId, id], onDelete: Cascade)

  @@unique([companyId, roleId, area])
  @@index([roleId])
  @@map("role_permissions")
}

model CompanyModule {
  id        String    @id @default(cuid())
  companyId String    @map("company_id")
  moduleKey ModuleKey @map("module_key")
  enabled   Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, moduleKey])
  @@index([companyId])
  @@map("company_modules")
}

model AuditEntry {
  id          String      @id @default(cuid())
  actorUserId String      @map("actor_user_id")
  companyId   String      @map("company_id")
  action      AuditAction
  targetType  String      @map("target_type")
  targetId    String      @map("target_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  actor   User    @relation(fields: [actorUserId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, createdAt])
  @@index([actorUserId])
  @@map("audit_entries")
}

// ===== Finance module (phase F2) =====
// Generated from Reference/erp-finance (77ce653) by tools/finance-schema/transform.py, then owned here.
// - Every table has company_id, a foreign key to companies, and a unique (company_id, id).
// - Every relation is composite (company_id, x_id) -> (company_id, id): no row can point at another company.
// - employee_id, requester_id, supervisor_id, voided_by_id, and owner_id reference memberships (decision A).
// - location_id references the foundation locations table.
// - Hand-written rules Prisma does not model are in migration 20261024100000_finance_schema:
//   the partial unique index on product barcodes and the journal_lines_center_guard trigger.

enum Currency {
  USD
  SYP
  EUR
  GBP
  TRY
  AED
  SAR
  JOD
  LBP
  IQD
  EGP
  QAR
  KWD
  CHF
  CAD
  CNY
}

/// Cash funds only: الخزائن، المحافظ الرقمية، البنوك.
/// Borrower custody is a receivable sub-ledger under account 1300 (see OpenItemKind.CUSTODY), never a fund.
enum FundType {
  VAULT
  SHAM_CASH
  BANK
}

enum TransactionStatus {
  COMPLETED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  DELETED
}

enum ExchangeType {
  BUY
  SELL
}

/// ISSUE: صرف عهدة من صندوق (Dr 1300 / Cr صندوق). RETURN: استرداد عهدة إلى صندوق.
/// OUTCOME: صادر من رصيد المستلف. EXCHANGE: تصريف عملة داخل الرصيد.
enum AdvanceType {
  OUTCOME
  EXCHANGE
  ISSUE
  RETURN
}

enum AuditActionType {
  UPDATE
  DELETE
}

enum AuditRequestStatus {
  PENDING
  APPROVED
  REJECTED
  DIRECT
}

enum NotificationStatus {
  UNREAD
  READ
}

model Borrower {
  id        String       @id @default(cuid())
  companyId String       @map("company_id")
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  advances  Advance[]
  openItems OpenItem[]

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@unique([companyId, id])
  @@index([companyId])
  @@map("borrowers")
}

model Project {
  id        String       @id @default(cuid())
  companyId String       @map("company_id")
  name      String
  status    RecordStatus @default(ACTIVE)
  /// Places the project appears: INCOME | OUTCOME | LOANS | REPORTS
  showIn    String[]     @default([]) @map("show_in")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  incomes      Income[]
  outcomes     Outcome[]
  advances     Advance[]
  costCenter   CostCenter?
  journalLines JournalLine[]

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@unique([companyId, id])
  @@index([companyId])
  @@map("projects")
}

model Bank {
  id        String       @id @default(cuid())
  companyId String       @map("company_id")
  name      String
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  incomes         Income[]
  outcomes        Outcome[]
  exchanges       Exchange[]
  transfersFrom   Transfer[]       @relation("TransferFromBank")
  transfersTo     Transfer[]       @relation("TransferToBank")
  advances        Advance[]
  openingBalances OpeningBalance[]

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, name])
  @@unique([companyId, id])
  @@index([companyId])
  @@map("banks")
}

model Income {
  id              String            @id @default(cuid())
  companyId       String            @map("company_id")
  operationNumber Int               @map("operation_number")
  transactionDate DateTime          @map("transaction_date") @db.Date
  systemDate      DateTime          @default(now()) @map("system_date")
  projectId       String?           @map("project_id")
  description     String            @default("")
  fund            FundType
  bankId          String?           @map("bank_id")
  sender          String            @default("")
  receiver        String            @default("")
  currency        Currency
  quantity        Decimal?          @db.Decimal(18, 4)
  amount          Decimal           @db.Decimal(18, 4)
  total           Decimal           @db.Decimal(18, 4)
  fxRate          Decimal?          @map("fx_rate") @db.Decimal(18, 6)
  attachments     String            @default("")
  notes           String            @default("")
  employeeId      String            @map("employee_id")
  locationId      String?           @map("location_id")
  status          TransactionStatus @default(COMPLETED)
  reference       String
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  project      Project?             @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  bank         Bank?                @relation(fields: [companyId, bankId], references: [companyId, id], onDelete: Restrict)
  employee     Membership           @relation(fields: [companyId, employeeId], references: [companyId, id])
  location     Location?            @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  salesPayment SalesInvoicePayment?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, reference])
  @@unique([companyId, id])
  @@index([companyId, transactionDate])
  @@index([companyId, status])
  @@index([employeeId])
  @@index([projectId])
  @@index([locationId])
  @@map("incomes")
}

model Outcome {
  id              String            @id @default(cuid())
  companyId       String            @map("company_id")
  operationNumber Int               @map("operation_number")
  transactionDate DateTime          @map("transaction_date") @db.Date
  systemDate      DateTime          @default(now()) @map("system_date")
  projectId       String?           @map("project_id")
  description     String            @default("")
  fund            FundType
  bankId          String?           @map("bank_id")
  deliverer       String            @default("")
  receiver        String            @default("")
  currency        Currency
  quantity        Decimal?          @db.Decimal(18, 4)
  amount          Decimal           @db.Decimal(18, 4)
  total           Decimal           @db.Decimal(18, 4)
  fxRate          Decimal?          @map("fx_rate") @db.Decimal(18, 6)
  attachments     String            @default("")
  notes           String            @default("")
  employeeId      String            @map("employee_id")
  locationId      String?           @map("location_id")
  status          TransactionStatus @default(COMPLETED)
  reference       String
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  project         Project?                @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  bank            Bank?                   @relation(fields: [companyId, bankId], references: [companyId, id], onDelete: Restrict)
  employee        Membership              @relation(fields: [companyId, employeeId], references: [companyId, id])
  location        Location?               @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)
  purchasePayment PurchaseInvoicePayment?

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, reference])
  @@unique([companyId, id])
  @@index([companyId, transactionDate])
  @@index([companyId, status])
  @@index([employeeId])
  @@index([projectId])
  @@index([locationId])
  @@map("outcomes")
}

model Exchange {
  id               String            @id @default(cuid())
  companyId        String            @map("company_id")
  operationNumber  Int               @map("operation_number")
  transactionDate  DateTime          @map("transaction_date") @db.Date
  systemDate       DateTime          @default(now()) @map("system_date")
  fund             FundType
  bankId           String?           @map("bank_id")
  exchangeType     ExchangeType      @map("exchange_type")
  paidCurrency     Currency          @map("paid_currency")
  receivedCurrency Currency          @map("received_currency")
  exchangeAmount   Decimal           @map("exchange_amount") @db.Decimal(18, 4)
  amountCurrency   Currency          @map("amount_currency")
  exchangeRate     Decimal           @map("exchange_rate") @db.Decimal(18, 6)
  total            Decimal           @db.Decimal(18, 4)
  attachments      String            @default("")
  notes            String            @default("")
  employeeId       String            @map("employee_id")
  locationId       String?           @map("location_id")
  status           TransactionStatus @default(COMPLETED)
  reference        String
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  bank     Bank?      @relation(fields: [companyId, bankId], references: [companyId, id], onDelete: Restrict)
  employee Membership @relation(fields: [companyId, employeeId], references: [companyId, id])
  location Location?  @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, reference])
  @@unique([companyId, id])
  @@index([companyId, transactionDate])
  @@index([companyId, status])
  @@index([employeeId])
  @@index([locationId])
  @@map("exchanges")
}

model Transfer {
  id              String            @id @default(cuid())
  companyId       String            @map("company_id")
  operationNumber Int               @map("operation_number")
  transactionDate DateTime          @map("transaction_date") @db.Date
  systemDate      DateTime          @default(now()) @map("system_date")
  fromFund        FundType          @map("from_fund")
  toFund          FundType          @map("to_fund")
  fromBankId      String?           @map("from_bank_id")
  toBankId        String?           @map("to_bank_id")
  currency        Currency
  fxRate          Decimal?          @map("fx_rate") @db.Decimal(18, 6)
  amount          Decimal           @db.Decimal(18, 4)
  attachments     String            @default("")
  notes           String            @default("")
  employeeId      String            @map("employee_id")
  locationId      String?           @map("location_id")
  status          TransactionStatus @default(COMPLETED)
  reference       String
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  fromBank Bank?      @relation("TransferFromBank", fields: [companyId, fromBankId], references: [companyId, id], onDelete: Restrict)
  toBank   Bank?      @relation("TransferToBank", fields: [companyId, toBankId], references: [companyId, id], onDelete: Restrict)
  employee Membership @relation(fields: [companyId, employeeId], references: [companyId, id])
  location Location?  @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, reference])
  @@unique([companyId, id])
  @@index([companyId, transactionDate])
  @@index([companyId, status])
  @@index([employeeId])
  @@index([locationId])
  @@map("transfers")
}

model Advance {
  id              String            @id @default(cuid())
  companyId       String            @map("company_id")
  operationNumber Int               @map("operation_number")
  transactionDate DateTime          @map("transaction_date") @db.Date
  systemDate      DateTime          @default(now()) @map("system_date")
  borrowerId      String            @map("borrower_id")
  advanceType     AdvanceType       @map("advance_type")
  projectId       String?           @map("project_id")
  description     String            @default("")
  receiver        String            @default("")
  currency        Currency
  quantity        Decimal?          @db.Decimal(18, 4)
  amount          Decimal           @db.Decimal(18, 4)
  exchangeRate    Decimal?          @map("exchange_rate") @db.Decimal(18, 6)
  total           Decimal           @db.Decimal(18, 4)
  fromCurrency    Currency?         @map("from_currency")
  toCurrency      Currency?         @map("to_currency")
  /// Cash side of an ISSUE or RETURN voucher. Null for OUTCOME and EXCHANGE (they never touch a fund).
  fund            FundType?
  bankId          String?           @map("bank_id")
  attachments     String            @default("")
  notes           String            @default("")
  employeeId      String            @map("employee_id")
  locationId      String?           @map("location_id")
  status          TransactionStatus @default(COMPLETED)
  reference       String
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  bank     Bank?      @relation(fields: [companyId, bankId], references: [companyId, id], onDelete: Restrict)
  borrower Borrower   @relation(fields: [companyId, borrowerId], references: [companyId, id])
  project  Project?   @relation(fields: [companyId, projectId], references: [companyId, id], onDelete: Restrict)
  employee Membership @relation(fields: [companyId, employeeId], references: [companyId, id])
  location Location?  @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, reference])
  @@unique([companyId, id])
  @@index([companyId, transactionDate])
  @@index([companyId, status])
  @@index([employeeId])
  @@index([borrowerId])
  @@index([locationId])
  @@map("advances")
}

model OpeningBalance {
  id              String            @id @default(cuid())
  companyId       String            @map("company_id")
  operationNumber Int               @map("operation_number")
  transactionDate DateTime          @map("transaction_date") @db.Date
  systemDate      DateTime          @default(now()) @map("system_date")
  fund            FundType
  bankId          String?           @map("bank_id")
  currency        Currency
  fxRate          Decimal?          @map("fx_rate") @db.Decimal(18, 6)
  amount          Decimal           @db.Decimal(18, 4)
  notes           String            @default("")
