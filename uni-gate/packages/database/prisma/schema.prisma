  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  requester  Membership  @relation("AuditRequester", fields: [companyId, requesterId], references: [companyId, id])
  supervisor Membership? @relation("AuditSupervisor", fields: [companyId, supervisorId], references: [companyId, id], onDelete: Restrict)
  location   Location?   @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, id])
  @@index([companyId, requestStatus])
  @@index([originalReference])
  @@index([requesterId])
