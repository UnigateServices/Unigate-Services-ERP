model Notification {
  id          String             @id @default(cuid())
  companyId   String             @map("company_id")
  employeeId  String             @map("employee_id")
  message     String
  occurredAt  DateTime           @default(now()) @map("occurred_at")
  status      NotificationStatus @default(UNREAD)
  section     String             @default("")
  requestId   String             @default("") @map("request_id")
  actionType  String             @default("") @map("action_type")
  reference   String             @default("")
  requesterId String?            @map("requester_id")
  locationId  String?            @map("location_id")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  employee  Membership  @relation("NotificationEmployee", fields: [companyId, employeeId], references: [companyId, id])
  requester Membership? @relation("NotificationRequester", fields: [companyId, requesterId], references: [companyId, id], onDelete: Restrict)
  location  Location?   @relation(fields: [companyId, locationId], references: [companyId, id], onDelete: Restrict)

  company Company @relation(fields: [companyId], references: [id])

